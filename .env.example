# IBM Quantum credentials (same names as QWARD papers framework)
IBM_QUANTUM_CHANNEL=
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=

# IBM Quantum Platform CRN (used for console session deep-links)
IBM_CATALOG_INSTANCE=

# Talk-app hardware batches: label=batch_id pairs (comma-separated)
# After a terminal run of shor_ibm.py, paste each batch_id here and restart backend.
IBM_BATCH_IDS=m3=,m4=,m6=,m8=

# Console deep-links:
#   batch → /instances/{crn_encoded}/sessions/{id}
#   job   → /instances/{crn_encoded}/jobs/{id}
IBM_CONSOLE_BASE=https://quantum.cloud.ibm.com
IBM_SESSION_PATH_TEMPLATE=/instances/{crn_encoded}/sessions/{id}
IBM_JOB_PATH_TEMPLATE=/instances/{crn_encoded}/jobs/{id}
IBM_WORKLOAD_PATH_TEMPLATE=/workloads/{id}

# Backend (used by Next rewrite when not in Docker)
BACKEND_URL=http://localhost:7001

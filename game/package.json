{
  "name": "rsa-hacker-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 7019",
    "build": "next build",
    "start": "next start -p 7019",
    "lint": "eslint app components content engine game i18n lib qollab --ext .ts,.tsx --max-warnings 0",
    "icons": "python3 tools/gen_pwa_icons.py",
    "test": "npm run test:unit && npm run test:ui",
    "build:qollab": "node tools/build-qollab.mjs",
    "verify:qollab": "node tools/verify-qollab.mjs",
    "test:unit": "node --test tests/*.test.cjs",
    "test:ui": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "excalibur": "^0.32.0",
    "next": "^15.1.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.23",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
